{
	"manifest_version": 3,
	"name": "3DOM",
	"description": "View a heatmap of your DOM in real time",
	"version": "1.0.0",
	"icons": {
		"16": "src/icons/icon16.png",
		"32": "src/icons/icon32.png",
		"48": "src/icons/icon48.png",
		"128": "src/icons/icon128.png"
	},
	"background": {
		"service_worker": "src/bridge.ts"
	},
	"content_scripts": [
		{
			"js": [
				"src/reader.ts"
			],
			"matches": [
				"http://*/*",
				"https://*/*"
			]
		}
	],
	"action": {

	},
	"permissions": [
		"scripting"
	],
	"host_permissions": [
		"http://*/*",
		"https://*/*"
	],
	"devtools_page": "src/3DOMWindow.html"
}